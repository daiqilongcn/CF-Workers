{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "cf-workers",
  "main": "worker.js",
  "compatibility_date": "2026-09-02",
  "placement": {
    // 让 Worker 跑在离上游最近的机房。placement 只影响 Worker 的执行位置
    // (Worker <-> zenmux.ai 这一段)，不影响用户请求进入 Cloudflare 的接入点。
    // aws:ap-southeast-1 = AWS 新加坡（zenmux.ai 部署在新加坡）；
    // 备选 gcp:asia-east1(台湾) / aws:ap-northeast-1(东京) / aws:ap-east-1(香港)
    "region": "aws:ap-southeast-1"
  }
}
